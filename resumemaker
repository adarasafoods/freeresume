    function downloadPDF() {
        const pages = document.querySelectorAll('.cv-page');
        const indicators = document.querySelectorAll('.page-indicator');
        
        // Hide indicators
        indicators.forEach(ind => ind.style.display = 'none');
        
        const opt = {
            margin: 0,
            filename: 'Professional_CV_' + document.getElementById('in-name').value.replace(/ /g, '_') + '.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { 
                scale: 2,
                useCORS: true,
                letterRendering: true,
                logging: false
            },
            jsPDF: { 
                unit: 'mm', 
                format: 'a4', 
                orientation: 'portrait'
            }
        };

        // Convert all pages
        const pdfPromises = Array.from(pages).map((page, index) => {
            return html2pdf().set(opt).from(page).toPdf().get('pdf').then(pdf => {
                return { pdf, index };
            });
        });

        Promise.all(pdfPromises).then(results => {
            const mainPdf = results[0].pdf;
            
            for (let i = 1; i < results.length; i++) {
                mainPdf.addPage();
                const pageData = results[i].pdf.internal.pages[1];
                mainPdf.internal.pages.push(pageData);
            }
            
            mainPdf.save('Professional_CV_' + document.getElementById('in-name').value.replace(/ /g, '_') + '.pdf');
            
            // Show indicators again
            indicators.forEach(ind => ind.style.display = 'block');
        });
    }
    
